name: {{ meta.short_id }}
networks:
  sandbox-net:
    driver: bridge
    ipam:
      config:
        - subnet: 172.28.0.0/16
          ip_range: 172.28.5.0/29

services:
  datadog-agent:
    image: gcr.io/datadoghq/agent:7
    depends_on: [squid-proxy, openmetrics]
    environment:
      DD_API_KEY: ${DD_API_KEY:?set DD_API_KEY in .env (sandbox org key)}
      DD_SITE: ${DD_SITE:-datadoghq.com}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /proc/:/host/proc/:ro
      - /sys/fs/cgroup/:/host/sys/fs/cgroup:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - ./ddconf/datadog.yaml:/etc/datadog-agent/datadog.yaml
      - ./conf.d/openmetrics.d:/etc/datadog-agent/conf.d/openmetrics.d
    networks: [sandbox-net]

  squid-proxy:
    build: ./squid
    networks: [sandbox-net]

  shop-app:
    build: ./shop-app
    depends_on: [datadog-agent]
    networks: [sandbox-net]

  openmetrics:
    build: ./openmetrics_app
    stop_signal: SIGINT
    networks:
      sandbox-net:
        ipv4_address: 172.28.5.4
