# Datadog Agent settings. DD_API_KEY / DD_SITE come from ../.env.
# Apply changes with: docker compose up -d
DD_USE_DOGSTATSD={{ p.USE_DOGSTATSD }}
DD_DOGSTATSD_NON_LOCAL_TRAFFIC={{ p.NON_LOCAL_TRAFFIC }}
DD_DOGSTATSD_METRICS_STATS_ENABLE=true
DD_HISTOGRAM_PERCENTILES={{ p.HISTOGRAM_PERCENTILES }}
DD_HISTOGRAM_AGGREGATES=max median avg count
DD_TAGS=sandbox:{{ meta.short_id }}
