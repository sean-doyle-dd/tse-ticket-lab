# Python service (Flask + ddtrace). Apply with: docker compose up -d
DD_SERVICE=storefront
DD_ENV={{ meta.short_id }}
DD_VERSION=1.0.0
DD_AGENT_HOST={{ p.STOREFRONT_AGENT_HOST }}
DD_TRACE_AGENT_PORT=8126
DD_LOGS_INJECTION={{ p.STOREFRONT_LOGS_INJECTION }}
DD_TRACE_SAMPLE_RATE={{ p.STOREFRONT_SAMPLE_RATE }}
DD_TRACE_STARTUP_LOGS=true
{%- if p.STOREFRONT_PROPAGATION == "none" %}
DD_TRACE_PROPAGATION_STYLE_INJECT=none
{%- endif %}
START_CMD={{ p.STOREFRONT_START_CMD }}
BACKEND_URL=http://inventory:3000
