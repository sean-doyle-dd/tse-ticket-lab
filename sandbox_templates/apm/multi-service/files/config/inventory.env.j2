# Node service (Express + pg + dd-trace). Apply with: docker compose up -d
DD_SERVICE=inventory
DD_ENV={{ meta.short_id if p.INVENTORY_ENV == "match" else "production" }}
DD_VERSION=1.0.0
DD_AGENT_HOST=datadog-agent
DD_TRACE_AGENT_PORT={{ p.INVENTORY_AGENT_PORT }}
DD_LOGS_INJECTION=true
DD_TRACE_STARTUP_LOGS=true
NODE_OPTIONS={{ "--require dd-trace/init" if p.INVENTORY_TRACER_LOADED == "yes" else "" }}
PGHOST=db
