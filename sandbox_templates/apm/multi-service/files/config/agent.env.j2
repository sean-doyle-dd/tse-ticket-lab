# Datadog Agent. DD_API_KEY and DD_SITE come from ../.env. Apply with: docker compose up -d
DD_APM_ENABLED={{ p.APM_ENABLED }}
DD_APM_NON_LOCAL_TRAFFIC={{ p.APM_NON_LOCAL_TRAFFIC }}
DD_LOGS_ENABLED=true
DD_LOGS_CONFIG_CONTAINER_COLLECT_ALL=true
DD_CONTAINER_EXCLUDE=name:.*datadog-agent.* name:.*traffic.*
DD_ENV={{ meta.short_id }}
DD_HOSTNAME={{ meta.short_id }}-host
