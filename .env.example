# ---------------------------------------------------------------- Claude
# claude_cli (Claude Code subscription login, no API key) | anthropic (API key)
# | bedrock (AWS credentials + AWS_REGION) | vertex (GCP ADC + VERTEX_PROJECT_ID)
LLM_PROVIDER=claude_cli
# claude_cli: run `claude setup-token` on your laptop and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# CLAUDE_CLI_CONCURRENCY=4
# CLAUDE_CLI_TIMEOUT=600
ANTHROPIC_API_KEY=
# AWS_REGION=us-east-1
# VERTEX_PROJECT_ID=
# VERTEX_REGION=global

# Models and effort per job (defaults shown).
# MODEL_GENERATOR=claude-opus-5-5
# MODEL_CUSTOMER=claude-sonnet-5-5
# MODEL_GRADER=claude-opus-5-5
# MODEL_CLASSIFIER=claude-haiku-5-5
# EFFORT_GENERATOR=high
# EFFORT_CUSTOMER=medium
# Server-side refusal fallbacks on the Claude API (recommended):
# LLM_FALLBACKS=true

# ---------------------------------------------------------------- Auth
# dev = name/email form (local only). google = Google SSO restricted to ALLOWED_EMAIL_DOMAIN.
AUTH_MODE=dev
ALLOWED_EMAIL_DOMAIN=datadoghq.com
# Required for AUTH_MODE=google (at least 32 random chars: `python3 -c "import secrets;print(secrets.token_hex(32))"`)
SECRET_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set true when served over HTTPS:
# SESSION_COOKIE_SECURE=true
# Comma-separated emails that can see the Team page:
ADMIN_EMAILS=

# ---------------------------------------------------------------- Limits
# GENERATIONS_PER_HOUR=10
# MESSAGES_PER_HOUR=120

# ---------------------------------------------------------------- Runtime
WEB_PORT=8095
# POSTGRES_PASSWORD=ticketlab
# Self-monitoring (docker compose --profile datadog up -d):
# DD_TRACE_ENABLED=true
# DD_API_KEY=
# DD_SITE=datadoghq.com
